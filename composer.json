{
  "name": "lamii/lamii",
  "type": "project",
  "description": "Lami helps you discover and connect with people around you in real time.",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/reverb": "^1.11",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.10",
    "laravel/socialite": "^5.30",
    "socialiteproviders/apple": "^5.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Tests\\": "tests/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
