APP_NAME=NearWave
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nearwave.example.com
SESSION_DRIVER=database
SESSION_LIFETIME=120
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nearwave
DB_USERNAME=nearwave
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/auth/apple/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=${APP_URL}/auth/x/callback
